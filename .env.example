# Copy to .env.local for `vercel dev`. Never commit the real file.

# Provider for the text prompt feature. Defaults to cloudflare when the CF_ variables are set,
# otherwise gemini when GEMINI_API_KEY is set. Set explicitly to force one.
IMAGE_PROVIDER=

# Cloudflare Workers AI (free plan: 10,000 neurons a day, no card needed).
# Dashboard -> AI -> Workers AI -> "Use REST API" shows both values.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Optional. Defaults to @cf/black-forest-labs/flux-1-schnell.
CF_IMAGE_MODEL=

# Google Gemini (paid tier only; the free tier has no image quota).
GEMINI_API_KEY=
# Optional. Defaults to gemini-nano-banana-2.1.
GEMINI_IMAGE_MODEL=

# Optional kill switch. Set to false to disable text prompts without a deploy.
PROMPTS_ENABLED=true
